###overall commands
docker stack deploy stack_name -c compose.yml
docker stack ls
docker service ls
docker stack rm beauty
docker service ps beauty_makeup
Note: It's okay to give 1111:80 instead of "1111:80"
      No container name
      Definitely img from docker registry
      For driver under ntw1, ntw2, ntw3, do mention overlay as good practice. However "docker compose up" defaults to bridge and "docker stack deploy" defaults stack networks to overlay.
#############################


services:
  makeup:
    image: apsanadevops/beauty:makeup
    ports:
      - 1111:80
    deploy:
      replicas: 4
    volumes:
      - vol1:/apsana
    networks:
      - ntw1
      - ntw2

  jewels:
    image: apsanadevops/beauty:jewels
    ports:
      - "2222:80"
    deploy:
      replicas: 5
    volumes:
      - vol2:/apsana
    networks:
      - ntw2
      - ntw1

  shoes:
    image: apsanadevops/beauty:shoes
    ports:
      - 3333:80
    deploy:
      replicas: 4
    volumes:
      - vol2:/apsana
    networks:
      - ntw3

volumes:
  vol1:
  vol2:

networks:
  ntw1:
    driver: overlay
  ntw2:
    driver: overlay
  ntw3:
    driver: overlay
