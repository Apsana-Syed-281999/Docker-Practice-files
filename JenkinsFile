pipeline{
    agent {
        node{
            label 'manager'
        }
    }
    tools{
        maven 'myMaven'
    } 
    stages{
        stage("Code"){
            steps{
                git branch: 'docker-webapp', url: 'https://github.com/Apsana-Syed-281999/Docker-Practice-files.git'
            }
        }
        stage("CQA"){
            steps{
                withSonarQubeEnv('mySonar') {
                sh '''
                 mvn -B clean verify \
                 org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                -Dsonar.projectKey=My_Sonar_Project \
                -Dsonar.host.url=http://184.195.136.74:1111 \
                -Dsonar.login=sqp_67df9c53dddae7a490dbe4874cbb2aaf1cc7896f
                '''
                }
            }
        }
        stage("QualityGates"){
            steps{
                waitForQualityGate abortPipeline: true, credentialsId: 'sonar-credentials'
            }
        }
        stage("Build"){
            steps{
                sh "mvn clean package"
                sh "cp -r target Docker-app"
            }
        }
        stage("Nexus Artifacts"){
            steps{
                nexusArtifactUploader artifacts: [[artifactId: 'vprofile', classifier: '', file: 'target/vprofile-v2.war', type: 'war']], credentialsId: 'nexus-credentials', groupId: 'com.visualpathit', nexusUrl: '44.202.202.84:8081/', nexusVersion: 'nexus3', protocol: 'http', repository: 'docker-webapp', version: '4.0.0'
            }
        }
        stage("Docker images with proper tag"){
            steps{
                sh 'docker build -t apsanadevops/docker-webapp:dbimg ./Docker-db'
                sh 'docker build -t apsanadevops/docker-webapp:appimg ./Docker-app'
            }
        
    }
        stage("Scan images"){
            steps{
                sh 'trivy image apsanadevops/docker-webapp:dbimg >> db-report.txt'
                sh 'trivy image apsanadevops/docker-webapp:appimg >> app-report.txt'
            }
        }
        stage("Images push"){
            steps{
                script{
                    withDockerRegistry(credentialsId: 'docker-credentials') {
                        sh 'docker push apsanadevops/docker-webapp:appimg'
                        sh 'docker push apsanadevops/docker-webapp:dbimg'
                    }
                }
            }
        }
        stage("Docker compose"){
            steps{
                sh 'docker stack deploy docker-webapp -c compose.yml'
            }
        }
    }
}
