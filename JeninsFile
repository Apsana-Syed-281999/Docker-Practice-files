pipeline{
    agent {
        node{
            label 'manager'
        }
    }
    environment{
        scannerHome = tool 'mySonar'
    }
    stages{
        stage("Code"){
            steps{
                git branch: 'monolethic-microservices-task', url: 'https://github.com/Apsana-Syed-281999/Docker-Practice-files.git'
            }
        }
        stage("CQA"){
            steps{
                withSonarQubeEnv('mySonar') {
                sh '''
                 ${scannerHome}/bin/sonar-scanner \
                 -Dsonar.projectKey=My_Sonar_Project \
                 -Dsonar.sources=. \
                '''
                }
            }
        }
        stage("QualityGates"){
            steps{
                waitForQualityGate abortPipeline: true, credentialsId: 'sonar-credentials'
            }
        }
        
        stage("Docker images with proper tag"){
            steps{
                sh 'docker build -t apsanadevops/monolethic:authimg ./auth'
                sh 'docker build -t apsanadevops/monolethic:bookimg ./book'
                sh 'docker build -t apsanadevops/monolethic:borrowimg ./borrow'
                sh 'docker build -t apsanadevops/monolethic:dbimg ./database'
                sh 'docker build -t apsanadevops/monolethic:frontendimg .'
            }
        
         }
        stage("Images push"){
            steps{
                script{
                    withDockerRegistry(credentialsId: 'docker-credentials') {
                        sh 'docker push apsanadevops/monolethic:authimg'
                        sh 'docker push apsanadevops/monolethic:bookimg'
                        sh 'docker push apsanadevops/monolethic:borrowimg'
                        sh 'docker push apsanadevops/monolethic:dbimg'
                        sh 'docker push apsanadevops/monolethic:frontendimg'
                    }
                }
            }
        }
        stage("Docker compose"){
            steps{
                sh 'docker stack deploy monolethic -c compose.yml'
            }
        }
    }
}
